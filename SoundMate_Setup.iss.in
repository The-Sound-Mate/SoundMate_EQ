; ============================================================================
; SoundMate_Setup.iss.in — v3.2 Final (Revised) Master Blueprint
; Auto-generated from SoundMate_Setup.iss.in by CMake.
; 직접 수정하지 마세요. CMakeLists.txt 의 project(... VERSION ...) 이 SoT.
;
; [설계 원칙]
;   1. 샌드박스 스테이징 배포: 바이너리를 {app}\_tmp_install\ 에 1차 복사하여
;      audiodg.exe 파일 잠금으로 인한 [Files] 복사 실패를 원천 차단.
;   2. 원자적 치환 + Graceful Degradation: ReplaceFileW 실패 시 PFRO 격하.
;   3. Zero-Pollution 롤백: 스테이징 폴더 삭제로 PFRO 무효화.
;   4. 이중 가드: SystemModified + InstallSucceeded / UninstallSucceeded.
; ============================================================================

[Setup]
AppName=SoundMate Equalizer

; [AppId 고정] 값 자체는 Inno 가 AppName 에서 자동 생성하던 기존 기본값과
;   완전히 같다. 즉 이미 깔려 있는 v0.0.x 도 그대로 "같은 앱" 으로 인식되어
;   제거 없이 덮어쓰기 업그레이드가 되고, 프로그램 추가/제거에 줄이 두 개
;   생기지 않는다. 명시해 두는 이유는 나중에 AppName 을 손대는 순간 업그레이드
;   경로가 조용히 끊기고 사용자마다 유령 항목이 남기 때문이다.
AppId=SoundMate Equalizer

; 파일 속성의 버전도 맞춰 둔다 — 설치된 setup.exe 를 나중에 식별할 때 쓴다.
VersionInfoVersion=@PROJECT_VERSION@

; 이전 설치 폴더를 그대로 따라간다 (다른 드라이브에 깔아 둔 사용자가
;   업그레이드 때 Program Files 로 끌려가지 않도록).
UsePreviousAppDir=yes
AppVersion=@PROJECT_VERSION@
DefaultDirName={commonpf}\SoundMate Equalizer
DefaultGroupName=SoundMate Equalizer
SourceDir=@CMAKE_CURRENT_SOURCE_DIR@
LicenseFile=Agreement.txt
PrivilegesRequired=admin
OutputBaseFilename=SoundMate_Setup_v@PROJECT_VERSION@
OutputDir=installer_output
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@\SoundMate_ImGui\assets\logo.ico
Compression=lzma
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; [APO Lock] 실행 중인 인스턴스 자동 감지 + WM_CLOSE 정상 종료. main.cpp 의
; CreateMutexW(L"Global\\SoundMate_EQ_AppMutex") 와 매칭. 구버전(v0.0.1)에는
; mutex 가 없어 PrepareToInstall 의 taskkill 폴백이 받친다.
AppMutex=Global\SoundMate_EQ_AppMutex
CloseApplications=force
RestartApplications=no

; DisableDirPage=no — 사용자가 설치 드라이브를 선택할 수 있되,
; NextButtonClick 에서 시스템/루트 폴더를 차단하여 안전성 확보.
DisableDirPage=no

[Languages]
Name: "korean"; MessagesFile: "@CMAKE_CURRENT_SOURCE_DIR@\Korean.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

; ============================================================================
; [Files] — 샌드박스 스테이징 배포
;
; APO DLL 및 잠금 위험이 있는 바이너리는 {app}\_tmp_install\ 에 1차 복사.
; 이 경로는 신규 생성 디렉토리이므로 audiodg.exe 가 잠글 수 없어
; [Files] 복사 단계는 항상 100% 성공한다.
;
; 잠금 위험이 없는 일반 파일(GUI EXE, config, assets 등)은 {app} 에 직접 복사.
; ============================================================================
[Files]
; --- 잠금 위험 파일: 스테이징 경로로 1차 복사 (restartreplace 사용 안 함) ---
Source: "@SM_RELEASE_BIN@\SoundMate_APO.dll"; DestDir: "{app}\_tmp_install"; Flags: ignoreversion

; --- 잠금 위험 없는 파일: {app} 에 직접 복사 ---
Source: "@SM_RELEASE_BIN@\SoundMate Equalizer.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@SM_RELEASE_BIN@\SoundMate_Controller.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@SM_RELEASE_BIN@\SoundMate_reset.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@SM_RELEASE_BIN@\SoundMate_uninstall.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@SM_RELEASE_BIN@\SoundMate_setup.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "@SM_RELEASE_BIN@\libcurl-x64.dll"; DestDir: "{app}"; Flags: ignoreversion

; config 및 기타 필요한 리소스들
Source: "config\*"; DestDir: "{app}\config"; Flags: ignoreversion recursesubdirs createallsubdirs

; 앨범 placeholder 등 assets
Source: "@SM_RELEASE_BIN@\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs

; 로그 수집 도구
Source: "tool\*"; DestDir: "{app}\tool"; Flags: ignoreversion recursesubdirs createallsubdirs

; ============================================================================
; [Registry] — 설치 경로를 남긴다.
;
; 이 값이 앱과 엔진이 설치 폴더를 찾는 유일한 권위 있는 출처다
; (engine/SoundMate_APO/include/SoundMate_InstallPaths.h 의 RootW()).
; 없으면 Program Files 로 폴백하므로, 다른 드라이브에 설치한 사용자는
; Controller 가 감시하지도 않는 config.txt 를 쓰게 된다.
;
; uninsdeletevalue 만 쓴다. uninsdeletekey 를 쓰면 같은 키 아래의
; "Child APOs" 백업(제거 시 OEM APO 복원에 필요)까지 날아간다.
; ============================================================================
[Registry]
Root: HKLM; Subkey: "SOFTWARE\SoundMateAPO"; ValueType: string; ValueName: "InstallPath"; ValueData: "{app}"; Flags: uninsdeletevalue
Root: HKLM; Subkey: "SOFTWARE\SoundMateAPO"; ValueType: string; ValueName: "ConfigPath"; ValueData: "{app}\config"; Flags: uninsdeletevalue

[Icons]
Name: "{group}\SoundMate Equalizer"; Filename: "{app}\SoundMate Equalizer.exe"
Name: "{commondesktop}\SoundMate Equalizer"; Filename: "{app}\SoundMate Equalizer.exe"; Tasks: desktopicon

[InstallDelete]
Type: filesandordirs; Name: "{app}\logs"
; 이전 설치가 중간에 죽으면서 남긴 스테이징 잔해. PrepareToInstall 에서도
;   지우지만, 그쪽이 돌기 전에 [Files] 가 먼저 닿는 경우를 대비해 한 번 더.
Type: filesandordirs; Name: "{app}\_tmp_install"

; ============================================================================
; [Run] — SoundMate_setup.exe 호출은 [Code] ssPostInstall 로 이동됨.
;         여기에는 설치 완료 후 프로그램 자동 실행만 남긴다.
; ============================================================================
[Run]
; 설치 완료 후 프로그램 자동 실행
Filename: "{app}\SoundMate Equalizer.exe"; Description: "{cm:LaunchProgram,SoundMate Equalizer}"; Flags: nowait postinstall skipifsilent shellexec

; C++ uninstall 바이너리가 APO 등록 해제 + 레지스트리 청소 담당.
; Parameters 의 {code:...} 는 제거 시점에 평가된다 — usUninstall 에서 사용자에게
; 물어본 답(KeepUserData)이 그대로 내려간다.
[UninstallRun]
Filename: "{app}\SoundMate_uninstall.exe"; Parameters: "{code:UninstallDataFlag}"; RunOnceId: "UninstallDriver"; Flags: runhidden waituntilterminated

; ============================================================================
; [Code] — v3.2 Final (Revised) 블루프린트 완전 구현
;
; 설계 근거: 48라운드 Claude vs Gemini 기술 토론 합의안.
; 핵심: 샌드박스 스테이징 + ReplaceFileW 원자적 치환 + PFRO Graceful Degradation
; ============================================================================
[Code]
const
  MOVEFILE_DELAY_UNTIL_REBOOT = $00000004;
  MOVEFILE_REPLACE_EXISTING   = $00000001;

// --- Win32 API 외부 함수 선언 ---

// 파일 재부팅 이동용 (Staging -> Target)
function MoveFileExW(lpExistingFileName, lpNewFileName: String; dwFlags: Cardinal): Boolean;
external 'MoveFileExW@kernel32.dll stdcall';

// 파일/폴더 재부팅 삭제용 (lpNewFileName = NULL → Longint 0)
function MoveFileExDelete(lpExistingFileName: String; lpNewFileName: Longint; dwFlags: Cardinal): Boolean;
external 'MoveFileExW@kernel32.dll stdcall';

// 원자적 파일 교체용
function ReplaceFileW(
  lpReplacedFileName, lpReplacementFileName, lpBackupFileName: String;
  dwReplaceFlags: Cardinal;
  lpExclude, lpReserved: Longint
): Boolean;
external 'ReplaceFileW@kernel32.dll stdcall';

// --- 전역 변수 ---
var
  NeedsReboot: Boolean;
  InstallSucceeded: Boolean;
  SystemModified: Boolean;

  UninstallNeedsReboot: Boolean;
  UninstallSucceeded: Boolean;
  UninstallSystemModified: Boolean;
  KeepUserData: Boolean;

  OrigPPLExists: Boolean;
  OrigPPLValue: Cardinal;

  // InitializeSetup 이 읽어 두는 "이미 깔려 있던 버전". 없으면 빈 문자열.
  PrevVersion: String;

// ============================================================================
// [공통] 설치 경로 검증 — 시스템/루트 폴더 차단 (UX 보존)
// ============================================================================
function NextButtonClick(CurPageID: Integer): Boolean;
var
  Dir, DirLower: String;
begin
  Result := True;
  if CurPageID = wpSelectDir then begin
    Dir := RemoveBackslashUnlessRoot(WizardDirValue);
    DirLower := Lowercase(Dir);

    // 드라이브 루트 (C:\, D:\ 등) 차단
    if (Length(DirLower) <= 3) and (DirLower[2] = ':') then begin
      MsgBox('드라이브 루트에는 직접 설치할 수 없습니다.' + #13#10 +
             '하위 폴더를 지정해 주세요.', mbError, MB_OK);
      Result := False;
      Exit;
    end;

    // 시스템 핵심 폴더 차단
    if (CompareText(Dir, ExpandConstant('{sys}')) = 0) or
       (CompareText(Dir, ExpandConstant('{commonpf}')) = 0) or
       (CompareText(Dir, ExpandConstant('{commonpf32}')) = 0) or
       (CompareText(Dir, ExpandConstant('{commoncf}')) = 0) or
       (CompareText(Dir, ExpandConstant('{win}')) = 0) then begin
      MsgBox('시스템 핵심 폴더에는 설치할 수 없습니다.' + #13#10 +
             'SoundMate EQ의 안전한 동작을 위해 전용 하위 폴더를 지정해 주세요.',
             mbError, MB_OK);
      Result := False;
    end;
  end;
end;

// ============================================================================
// [설치] PPL 백업/복원 헬퍼
// ============================================================================
procedure BackupPPL;
var
  Val: Cardinal;
begin
  if RegQueryDWordValue(HKLM, 'SYSTEM\CurrentControlSet\Control\Audio',
                        'DisableProtectedAudioDG', Val) then begin
    OrigPPLExists := True;
    OrigPPLValue := Val;
  end else begin
    OrigPPLExists := False;
    OrigPPLValue := 0;
  end;
end;

procedure RestorePPL;
begin
  if OrigPPLExists then
    RegWriteDWordValue(HKLM, 'SYSTEM\CurrentControlSet\Control\Audio',
                       'DisableProtectedAudioDG', OrigPPLValue)
  else
    RegDeleteValue(HKLM, 'SYSTEM\CurrentControlSet\Control\Audio',
                   'DisableProtectedAudioDG');
end;

// ============================================================================
// [공통] 오디오 스택 정지 — APO DLL 잠금 해제의 핵심
//
// SoundMate_APO.dll 을 물고 있는 프로세스는 audiodg.exe 하나가 아니다.
// AudioEndpointBuilder(svchost) 도 엔드포인트 속성을 읽으려고 APO 를
// CoCreate 하면서 같은 DLL 을 로드한다. audiosrv 만 멈추면 이쪽 핸들이
// 그대로 남아 ReplaceFileW 가 실패하고, 설치는 조용히 PFRO(재부팅 대기)로
// 격하된다. 사용자가 "나중에 재시작" 을 누르면 새 EXE + 구버전 DLL 조합으로
// 계속 돌아간다 — 앱별 EQ 목록이 비고 스펙트럼이 실제 출력 대신 기본
// 파형으로 나오던 원인이 정확히 이것이다.
//
// audiosrv 는 AudioEndpointBuilder 에 의존하므로 /y 하나로 함께 내려간다.
// 되살리는 순서는 그 반대(audiosrv → AudioEndpointBuilder)이고, 그건
// SoundMate_setup.exe 의 RestartAudioServicesSC 와 롤백 경로가 담당한다.
//
// [순서 주의] 앱을 먼저 죽이고 그 다음 audiodg 를 죽인다. 반대로 하면
//   실행 중인 SoundMate 의 EngineHealthMonitor 가 audiodg 사망을 "엔진
//   고장" 으로 보고 APO 등록(CLSID 2개 + HKLM\SOFTWARE\SoundMateAPO +
//   AudioEngine 신뢰 키)을 스스로 지워 버린다.
// ============================================================================
procedure QuiesceAudioStack;
var
  Rc, Retry: Integer;
begin
  // 1) 앱 먼저 — audiodg 를 건드리기 전에 반드시.
  Exec(ExpandConstant('{cmd}'),
       '/C taskkill /F /IM "SoundMate Equalizer.exe" /IM SoundMate_Controller.exe /IM MainController.exe',
       '', SW_HIDE, ewWaitUntilTerminated, Rc);

  // 2) AudioEndpointBuilder 정지 (/y 로 의존 서비스 audiosrv 까지 함께).
  Exec(ExpandConstant('{cmd}'),
       '/C net stop AudioEndpointBuilder /y',
       '', SW_HIDE, ewWaitUntilTerminated, Rc);
  // 구성에 따라 위 한 방으로 안 내려가는 경우가 있어 audiosrv 를 한 번 더.
  Exec(ExpandConstant('{cmd}'),
       '/C net stop audiosrv /y',
       '', SW_HIDE, ewWaitUntilTerminated, Rc);

  // 3) audiodg.exe 강제 종료 (Bounded Retry 15회).
  for Retry := 1 to 15 do begin
    if Exec(ExpandConstant('{cmd}'),
            '/C taskkill /F /IM audiodg.exe',
            '', SW_HIDE, ewWaitUntilTerminated, Rc) then begin
      if Rc = 0 then begin
        Log('[QuiesceAudioStack] audiodg.exe killed at retry #' + IntToStr(Retry));
        Break;
      end;
    end;
    Sleep(200);
  end;

  // 4) 커널이 실제로 핸들을 놓을 때까지 대기.
  Sleep(800);
end;

// ============================================================================
// [설치] InitializeSetup — 이미 깔려 있는 버전 확인
//
// AppId 가 같으므로 제거하지 않고 그대로 덮어쓰기 업그레이드가 된다.
// 여기서는 막지 않고 기록만 한다 — 업데이트 동작을 보려고 일부러 구버전을
// 깔아 보는 경우가 있어서, 버전을 되돌리는 것도 막지 않는다.
// 읽어 둔 값은 PrepareToInstall 의 안내 문구에 쓴다.
// ============================================================================
function InitializeSetup(): Boolean;
var
  Prev: String;
begin
  Result := True;
  PrevVersion := '';

  if RegQueryStringValue(HKLM,
       'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\SoundMate Equalizer_is1',
       'DisplayVersion', Prev) then
    PrevVersion := Prev;

  if PrevVersion = '' then
    Log('[InitializeSetup] No previous install found — fresh install.')
  else if CompareText(PrevVersion, '@PROJECT_VERSION@') = 0 then
    Log('[InitializeSetup] Reinstalling the same version: ' + PrevVersion)
  else
    Log('[InitializeSetup] Replacing installed version ' + PrevVersion +
        ' with @PROJECT_VERSION@');
end;

// ============================================================================
// [설치] 개별 파일 정밀 배포 루틴 — DeployFile
//
// 3분기:
//   1. NeedsReboot=True → MoveFileExW PFRO 예약
//   2. 업그레이드 (기존 파일 존재) → ReplaceFileW (실패 시 PFRO 격하)
//   3. 신규 설치 → RenameFile
// ============================================================================
procedure DeployFile(const FileName: String);
var
  StagingPath, TargetPath, BackupPath: String;
  Attempt: Integer;
  Swapped: Boolean;
begin
  StagingPath := ExpandConstant('{app}\_tmp_install\' + FileName);
  TargetPath := ExpandConstant('{app}\' + FileName);
  BackupPath := TargetPath + '.bak';

  if not FileExists(StagingPath) then begin
    Log('[DeployFile] Staging file not found, skip: ' + FileName);
    Exit;
  end;

  // 분기 1: PrepareToInstall 에서 잠금이 확인된 경우 → 즉시 PFRO 예약
  if NeedsReboot then begin
    MoveFileExW(StagingPath, TargetPath,
                MOVEFILE_DELAY_UNTIL_REBOOT or MOVEFILE_REPLACE_EXISTING);
    Log('[DeployFile] PFRO scheduled (NeedsReboot was set): ' + FileName);
  end

  // 분기 2: 업그레이드 — 기존 파일 위에 원자적 치환 시도
  else if FileExists(TargetPath) then begin
    // ReplaceFileW: 백업 경로를 명시적으로 전달해야 함.
    // 빈 문자열 '' 전달 시 Pascal Script 마샬링이 NULL 대신 L"\0" 을 보내
    // ERROR_INVALID_PARAMETER 를 유발하므로 반드시 .bak 경로를 사용.
    //
    // [재시도] 첫 실패는 대개 멈춰 둔 오디오 스택이 되살아나면서 DLL 을
    //   다시 문 것이다. 여기서 곧장 PFRO 로 내려버리면 사용자가 재부팅을
    //   미루는 순간 구버전 엔진으로 계속 돌아간다. 스택을 다시 재우고
    //   3번까지 다시 시도한 뒤에야 PFRO 로 격하한다.
    Swapped := False;
    for Attempt := 1 to 3 do begin
      if ReplaceFileW(TargetPath, StagingPath, BackupPath, 0, 0, 0) then begin
        Swapped := True;
        Break;
      end;
      Log('[DeployFile] ReplaceFileW attempt #' + IntToStr(Attempt) +
          ' failed: ' + FileName + ' — re-quiescing audio stack.');
      QuiesceAudioStack;
    end;

    if Swapped then begin
      // 치환 성공 → 백업 파일 즉시 제거
      DeleteFile(BackupPath);
      Log('[DeployFile] ReplaceFileW succeeded: ' + FileName);
    end else begin
      // 3번 다 실패 → 안전하게 PFRO 로 격하.
      // DeleteFile + RenameFile 같은 비원자적 강제 교체는 절대 시도하지 않는다.
      MoveFileExW(StagingPath, TargetPath,
                  MOVEFILE_DELAY_UNTIL_REBOOT or MOVEFILE_REPLACE_EXISTING);
      NeedsReboot := True;
      Log('[DeployFile] ReplaceFileW failed 3x, fallback to PFRO: ' + FileName);
    end;
  end

  // 분기 3: 신규 설치 — 타겟이 없으므로 즉시 이동
  else begin
    if RenameFile(StagingPath, TargetPath) then
      Log('[DeployFile] RenameFile succeeded (fresh install): ' + FileName)
    else begin
      // 예외: RenameFile 마저 실패 → PFRO 최종 안전망
      MoveFileExW(StagingPath, TargetPath,
                  MOVEFILE_DELAY_UNTIL_REBOOT or MOVEFILE_REPLACE_EXISTING);
      NeedsReboot := True;
      Log('[DeployFile] RenameFile failed, fallback to PFRO: ' + FileName);
    end;
  end;
end;

// ============================================================================
// [설치] PrepareToInstall — 잠금 해제 + 스테이징 잔해 정리
// ============================================================================
function PrepareToInstall(var NeedsRestartParam: Boolean): String;
var
  Rc: Integer;
begin
  Result := '';
  NeedsReboot := False;
  InstallSucceeded := False;
  SystemModified := False;

  // 0) 이전 설치 실패로 남은 _tmp_install 폴더 선제 청소
  if DirExists(ExpandConstant('{app}\_tmp_install')) then begin
    DelTree(ExpandConstant('{app}\_tmp_install'), True, True, True);
    Log('[PrepareToInstall] Cleaned residual _tmp_install folder.');
  end;

  // 1) 구버전(v0.0.1) 폴백 — 옛 프로세스 강제 종료
  Exec(ExpandConstant('{cmd}'),
       '/C taskkill /F /IM "SoundMate Equalizer.exe" /IM SoundMate_Controller.exe /IM MainController.exe',
       '', SW_HIDE, ewWaitUntilTerminated, Rc);

  // 2) PPL 백업 후 보호 일시 비활성화
  BackupPPL;
  RegWriteDWordValue(HKLM, 'SYSTEM\CurrentControlSet\Control\Audio',
                     'DisableProtectedAudioDG', 1);
  SystemModified := True;

  // 3) 오디오 스택 정지 — 앱 종료 → AudioEndpointBuilder/audiosrv 정지 →
  //    audiodg 강제 종료. APO DLL 핸들을 쥔 쪽을 전부 놓게 만든다.
  if PrevVersion <> '' then
    WizardForm.PreparingLabel.Caption :=
      '기존 버전 ' + PrevVersion + ' 위에 덮어씁니다. 오디오 서비스를 잠시 멈춥니다' +
      ' (5~30초간 소리가 끊길 수 있습니다)'
  else
    WizardForm.PreparingLabel.Caption :=
      '오디오 서비스를 일시 중지하고 파일을 교체합니다 (5~30초간 음원이 일시 정지될 수 있습니다)';

  QuiesceAudioStack;

  // NeedsReboot 는 여기서 False 로 유지.
  // 실제 잠금 판정은 ssPostInstall 의 DeployFile 에서 ReplaceFileW 결과로 결정.
  // (TOCTOU 방지: PrepareToInstall 에서 IsFileLocked 를 재확인하지 않음)
end;

// ============================================================================
// [설치] ssPostInstall — 스테이징 파일 최종 배포 + 드라이버 등록
// ============================================================================
procedure CurStepChanged(CurStep: TSetupStep);
var
  Rc: Integer;
begin
  if CurStep = ssPostInstall then begin

    // --- 1. APO DLL 배포 ---
    DeployFile('SoundMate_APO.dll');

    // --- 2. 드라이버 레지스트리 등록 (SoundMate_setup.exe) ---
    // SoundMate_setup.exe 내부에서 RestartAudioServicesSC() 로 audiosrv 를
    // dependency 순서대로 재시작한다. NeedsReboot=True 면 서비스 시작을 스킵해야
    // 하므로 구분이 필요하다.
    if not NeedsReboot then begin
      // 정상 경로: 파일 교체 성공 → setup.exe 가 레지스트리 등록 + 서비스 재시작 수행
      if FileExists(ExpandConstant('{app}\SoundMate_setup.exe')) then begin
        Exec(ExpandConstant('{app}\SoundMate_setup.exe'), '',
             '', SW_HIDE, ewWaitUntilTerminated, Rc);
        if Rc = 0 then begin
          Log('[ssPostInstall] SoundMate_setup.exe succeeded. Audio service restarted.');
          InstallSucceeded := True;
        end else begin
          Log('[ssPostInstall] SoundMate_setup.exe failed with code: ' + IntToStr(Rc));
          InstallSucceeded := False;
        end;
      end;

      // 스테이징 빈 폴더 즉시 삭제
      DelTree(ExpandConstant('{app}\_tmp_install'), True, True, True);
    end else begin
      // PFRO 경로: 파일은 재부팅 시 교체 예정.
      // 레지스트리는 선행 등록하되 서비스 시작은 스킵하여 안전 무음 유지.
      // (APO CLSID 가 버전 간 불변이므로 과도기 불일치 없음)
      if FileExists(ExpandConstant('{app}\SoundMate_setup.exe')) then begin
        Exec(ExpandConstant('{app}\SoundMate_setup.exe'), '',
             '', SW_HIDE, ewWaitUntilTerminated, Rc);
        Log('[ssPostInstall] SoundMate_setup.exe ran in PFRO mode (reboot pending).');
      end;

      // 스테이징 폴더 재부팅 시 삭제 예약
      MoveFileExDelete(ExpandConstant('{app}\_tmp_install'), 0,
                       MOVEFILE_DELAY_UNTIL_REBOOT);
      Log('[ssPostInstall] _tmp_install PFRO delete scheduled.');

      // 재부팅 전까지는 구버전 DLL 이 계속 audiodg 에 올라가 있다. Inno 의
      //   기본 재시작 안내는 "나중에" 를 누르기 쉬워서, 그대로 두면 새 EXE +
      //   구버전 엔진 조합으로 돌게 된다 (앱별 EQ 목록이 비고 스펙트럼이
      //   실제 출력 대신 기본 파형으로 나온다). 그래서 따로 알린다.
      if not WizardSilent then
        MsgBox('오디오 엔진 파일이 사용 중이라 지금 교체하지 못했습니다.' + #13#10 +
               '교체는 재부팅할 때 자동으로 끝납니다.' + #13#10#13#10 +
               '재부팅 전까지는 이전 버전 엔진이 그대로 동작합니다.' + #13#10 +
               '이 상태에서는 앱별 EQ 목록과 실시간 주파수 표시가' + #13#10 +
               '정상 동작하지 않습니다.',
               mbInformation, MB_OK);
      InstallSucceeded := True;
    end;
  end;
end;

// ============================================================================
// [설치] NeedRestart — 재부팅 프롬프트 이중 방어
//
// restartreplace 를 사용하지 않으므로 이 함수가 유일한 재부팅 트리거.
// ============================================================================
function NeedRestart(): Boolean;
begin
  Result := NeedsReboot;
end;

// ============================================================================
// [설치] DeinitializeSetup — 안전 롤백 + 서비스 복구
//
// 설치 취소/실패 시:
//   - _tmp_install 폴더 삭제 → PFRO 예약이 남아있어도 원본 부재로 커널이 스킵
//   - 서비스 복구 + PPL 복원
// ============================================================================
procedure DeinitializeSetup();
var
  Rc: Integer;
begin
  if (not InstallSucceeded) and SystemModified then begin
    Log('[DeinitializeSetup] Rollback triggered.');

    // Zero-Pollution 롤백: 스테이징 폴더 파괴
    DelTree(ExpandConstant('{app}\_tmp_install'), True, True, True);

    // 서비스 복구 (NeedsReboot=True 면 서비스 시작이 무의미하지만 안전망)
    Exec(ExpandConstant('{cmd}'),
         '/C net start AudioEndpointBuilder & net start audiosrv',
         '', SW_HIDE, ewWaitUntilTerminated, Rc);

    // PPL 원래 상태 복원
    RestorePPL;
    Log('[DeinitializeSetup] Rollback complete.');
  end else if InstallSucceeded and (not NeedsReboot) then begin
    // 정상 완료: 서비스가 이미 setup.exe 에 의해 기동됨. 추가 조치 없음.
  end else if InstallSucceeded and NeedsReboot then begin
    // PFRO 정상 완료: 재부팅 안내가 표시됨. 서비스 건드리지 않음.
    // PPL 은 재부팅 후 Windows 기본값으로 자동 복원되므로 별도 처리 불필요.
  end;
end;

// ============================================================================
// ================== 제거 (Uninstaller) ====================
// ============================================================================

// --- 제거용 파일 수동 삭제 헬퍼 (PFRO 삭제 지원) ---
procedure CleanUpFile(const Path: String);
begin
  if FileExists(Path) then begin
    if not DeleteFile(Path) then begin
      // 즉시 삭제 실패 → 재부팅 후 커널 삭제 예약
      MoveFileExDelete(Path, 0, MOVEFILE_DELAY_UNTIL_REBOOT);
      UninstallNeedsReboot := True;
      Log('[CleanUpFile] File locked, PFRO delete scheduled: ' + Path);
    end else begin
      Log('[CleanUpFile] Deleted: ' + Path);
    end;
  end;
end;

// --- [UninstallRun] 에 넘길 인자 ---
// usUninstall 에서 물어본 답을 SoundMate_uninstall.exe 의 명령줄로 옮긴다.
// 인자가 없으면 그 exe 는 예전과 똑같이 전부 지운다.
function UninstallDataFlag(Param: String): String;
begin
  if KeepUserData then
    Result := '--keep-data'
  else
    Result := '';
end;

// --- 제거 단계 처리 ---
procedure CurUninstallStepChanged(CurStep: TUninstallStep);
var
  Rc: Integer;
begin
  if CurStep = usUninstall then begin
    UninstallSystemModified := False;
    UninstallSucceeded := False;
    UninstallNeedsReboot := False;

    // --- 사용자 데이터를 남길지 묻는다 ---
    // record\ 안에 곡별 EQ, song_cache.json, 설문 결과, 로그인 세션이 있고
    // config\ 안에 프리셋이 있다. 남기면 재설치 후 쓰던 소리를 그대로 이어받는다.
    // 답은 [UninstallRun] 의 {code:UninstallDataFlag} 를 통해
    // SoundMate_uninstall.exe 의 --keep-data 인자로 내려간다.
    //
    // 무인 제거(/SILENT)에서는 물어볼 수가 없다. 그때는 남기는 쪽으로 둔다 —
    // 되돌릴 수 없는 삭제를 아무 말 없이 하는 것보다 폴더가 남는 편이 낫다.
    if UninstallSilent then begin
      KeepUserData := True;
      Log('[usUninstall] Silent uninstall — keeping user data by default.');
    end else begin
      KeepUserData := (MsgBox(
        'Keep your SoundMate data?' + #13#10#13#10 +
        'Your per-song EQ settings, presets, survey results and sign-in' + #13#10 +
        'session are stored in the installation folder:' + #13#10 +
        ExpandConstant('{app}') + #13#10#13#10 +
        'Yes  -  Keep this data. A future re-install will pick it up.' + #13#10 +
        'No   -  Delete everything, including your saved settings.',
        mbConfirmation, MB_YESNO) = IDYES);
      if KeepUserData then
        Log('[usUninstall] User chose to KEEP data.')
      else
        Log('[usUninstall] User chose to DELETE data.');
    end;

    // PPL 백업 + 보호 비활성화
    BackupPPL;
    RegWriteDWordValue(HKLM, 'SYSTEM\CurrentControlSet\Control\Audio',
                       'DisableProtectedAudioDG', 1);
    UninstallSystemModified := True;

    // 오디오 스택 정지 — 설치 때와 같은 이유로 AudioEndpointBuilder 까지
    //   함께 내려야 SoundMate_APO.dll 핸들이 풀린다.
    QuiesceAudioStack;
  end

  else if CurStep = usPostUninstall then begin
    // 개별 파일 수동 제거 (잠금 시 PFRO 격하)
    CleanUpFile(ExpandConstant('{app}\SoundMate_APO.dll'));

    // PFRO 시나리오: {app} 폴더 자체도 재부팅 삭제 예약 (Best-effort)
    // 단, 데이터를 남기기로 했으면 예약하지 않는다. 남기겠다고 답해 놓고
    // 재부팅 후에 폴더째 사라지면 그게 제일 나쁜 결과다.
    // (MoveFileExW 는 비어 있지 않은 폴더는 어차피 못 지우지만, 의도를
    //  코드로 못박아 둔다.)
    if UninstallNeedsReboot and (not KeepUserData) then begin
      MoveFileExDelete(ExpandConstant('{app}'), 0, MOVEFILE_DELAY_UNTIL_REBOOT);
      Log('[usPostUninstall] {app} folder PFRO delete scheduled (best-effort).');
    end;

    // 서비스 및 PPL 복원
    if not UninstallNeedsReboot then begin
      Exec(ExpandConstant('{cmd}'),
           '/C net start AudioEndpointBuilder & net start audiosrv',
           '', SW_HIDE, ewWaitUntilTerminated, Rc);
      RestorePPL;
    end else begin
      // 재부팅 대기 중: 서비스 시작 스킵, PPL만 복원
      RestorePPL;
    end;

    UninstallSucceeded := True;
  end;
end;

// --- 제거 시 재시작 필수 통보 ---
function UninstallNeedRestart(): Boolean;
begin
  Result := UninstallNeedsReboot;
end;

// --- 제거 롤백 (취소/실패 시) ---
procedure DeinitializeUninstall();
var
  Rc: Integer;
begin
  if (not UninstallSucceeded) and UninstallSystemModified then begin
    Log('[DeinitializeUninstall] Rollback triggered.');
    RestorePPL;
    Exec(ExpandConstant('{cmd}'),
         '/C net start AudioEndpointBuilder & net start audiosrv',
         '', SW_HIDE, ewWaitUntilTerminated, Rc);
  end;
end;
